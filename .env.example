# Copia este archivo a ".env" y ajusta los valores.

# Cadena de conexion a PostgreSQL.
# Local con Docker:      postgresql://mkgv:mkgv@localhost:5432/mkgv_dashboard?schema=public
# Servicio en la nube (Supabase / Neon / Railway): pega aqui la connection string que te den.
DATABASE_URL="postgresql://mkgv:mkgv@localhost:5432/mkgv_dashboard?schema=public"
